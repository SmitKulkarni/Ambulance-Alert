# ─── Required ──────────────────────────────────────────────────────────────────

# Gemini AI API key — injected by AI Studio at runtime from user secrets.
# Never hardcode. Never prefix with VITE_ (would expose to browser bundle).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# The URL where this app is hosted (Cloud Run service URL in production).
# Used for CORS origin, OAuth callbacks, and self-referential links.
APP_URL="MY_APP_URL"

# ─── Authentication ────────────────────────────────────────────────────────────

# JWT signing secret — use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION"

# JWT token expiry (any value accepted by the `jsonwebtoken` package)
# Examples: 8h, 1d, 7d
JWT_EXPIRES_IN="8h"

# ─── Server ────────────────────────────────────────────────────────────────────

# Port for the Express + WebSocket server (separate from Vite dev server on 3000)
SERVER_PORT="4000"

# ─── Frontend API URL ──────────────────────────────────────────────────────────

# Base URL for API calls from the Vite frontend.
# In production, set this to your Express server URL.
# In dev, defaults to http://localhost:4000 if not set (see src/utils/api.ts).
VITE_API_URL="http://localhost:4000"

# ─── Database (Phase 2 — PostgreSQL) ──────────────────────────────────────────
# Uncomment when migrating from in-memory store to PostgreSQL.
# See db/schema.sql to create the tables.

# DATABASE_URL="postgresql://user:password@localhost:5432/ambulance_alert"
# DB_SSL="false"
